#lang scribble/manual
@(require json racket/string racket/list scribble/core scribble/html-properties)
@title{Prob-bench}

@(define info (with-input-from-file "info.json"
                (lambda () (read-json))))

@(define (raw-elem tag . attrs)
   (lambda pre-content
     (element (style #f (list (alt-tag tag) (attributes attrs))) pre-content)))

@(define (all-tags)
   (sort (remove-duplicates (append-map (lambda (tags) tags) (hash-values info)))
         string<?))

@(define (language-tag? tag) (string-prefix? tag "language:"))
@(define (language-tags) (filter language-tag? (all-tags)))
@(define (feature-tags) (filter (lambda (tag) (not (language-tag? tag))) (all-tags)))

@(define (tag-display-name tag)
   (if (language-tag? tag) (substring tag (string-length "language:")) tag))

@(define (tag-chip tag #:type [type "checkbox"] #:name [name #f])
   (define input-attrs
     (append (list (cons 'type type) (cons 'class "tagfilter") (cons 'data-tag tag))
             (if name (list (cons 'name name)) '())))
   ((raw-elem "label" '(class . "chip"))
    (list ((apply raw-elem "input" input-attrs) "")
          ((raw-elem "span" '(class . "chip-label")) (tag-display-name tag)))))

@(define (language-chip tag) (tag-chip tag #:type "radio" #:name "language-filter"))

@(define (tag-badge tag)
   ((raw-elem "span" '(class . "tag-badge")) (tag-display-name tag)))

@(define (download-icon)
   ((raw-elem "svg" '(viewBox . "0 0 24 24") '(width . "16") '(height . "16")
              '(fill . "none") '(stroke . "currentColor") '(stroke-width . "2")
              '(stroke-linecap . "round") '(stroke-linejoin . "round"))
    (list ((raw-elem "path" '(d . "M12 3v12")) "")
          ((raw-elem "path" '(d . "M7 10l5 5 5-5")) "")
          ((raw-elem "path" '(d . "M5 19h14")) ""))))

@(define (download-link path)
   ((raw-elem "a" '(class . "benchmark-download") (cons 'href (path->string path)) '(download . "")
              '(aria-label . "Download") '(title . "Download"))
    (download-icon)))

@(define (close-icon)
   ((raw-elem "svg" '(viewBox . "0 0 24 24") '(width . "18") '(height . "18")
              '(fill . "none") '(stroke . "currentColor") '(stroke-width . "2")
              '(stroke-linecap . "round") '(stroke-linejoin . "round"))
    (list ((raw-elem "path" '(d . "M6 6l12 12")) "")
          ((raw-elem "path" '(d . "M18 6l-12 12")) ""))))

@(define (benchmark-item path tags)
   (define tags-str (string-join tags " "))
   (item
    ((raw-elem "span" '(class . "benchmark-item") (cons 'data-tags tags-str))
     (list ((raw-elem "span" '(class . "benchmark-info") '(role . "button") '(tabindex . "0"))
            (list ((raw-elem "span" '(class . "benchmark-path")) (path->string path))
                  ((raw-elem "span" '(class . "benchmark-tags")) (map tag-badge tags))))
           (download-link path)))))

@(define (all-benchmarking-paths)
  (for/list ([path (in-directory "benchmark")]
             #:unless (directory-exists? path)
             #:when (hash-has-key? info (string->symbol (path->string path))))
    (define tags (hash-ref info (string->symbol (path->string path))))
    (benchmark-item path tags)))

@(list
  ((raw-elem "link" '(rel . "stylesheet") '(href . "style.css")) "")
  ((raw-elem "div" '(class . "hero"))
   (list ((raw-elem "p" '(class . "eyebrow")) "Roulette Research")
         ((raw-elem "p" '(class . "subtitle"))
          "A cross-language benchmarking suite for probabilistic programming languages.")))
  ((raw-elem "div" '(class . "filter-panel"))
   (list ((raw-elem "span" '(class . "filter-label")) "Filter by language")
         ((raw-elem "div" '(class . "chip-row")) (map language-chip (language-tags)))))
  ((raw-elem "div" '(class . "filter-panel"))
   (list ((raw-elem "span" '(class . "filter-label")) "Tags")
         ((raw-elem "div" '(class . "chip-row")) (map tag-chip (feature-tags)))))
  ((raw-elem "div" '(class . "list-toolbar"))
   (list ((raw-elem "span" '(id . "result-count") '(class . "result-count")) "")
         ((raw-elem "button" '(type . "button") '(id . "download-zip") '(class . "zip-button"))
          (list (download-icon) "Download as .zip"))))
  (apply itemlist #:style "benchmark-list" (all-benchmarking-paths))
  ((raw-elem "div" '(id . "preview-overlay") '(class . "preview-overlay") '(hidden . "hidden"))
   ((raw-elem "div" '(class . "preview-dialog") '(role . "dialog") '(aria-modal . "true"))
    (list ((raw-elem "div" '(class . "preview-header"))
           (list ((raw-elem "span" '(class . "preview-filename")) "")
                 ((raw-elem "button" '(type . "button") '(class . "preview-close") '(aria-label . "Close"))
                  (close-icon))))
          ((raw-elem "pre" '(class . "preview-content")) ((raw-elem "code") "")))))
  ((raw-elem "script" '(src . "filter.js")) "")
  ((raw-elem "script" '(src . "zip.js")) "")
  ((raw-elem "script" '(src . "preview.js")) ""))
